#include <zephyr/dt-bindings/gpio/gpio.h>

&button0 {
    gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

&led0 {
    gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;  /* Header 100 */
};

&led1 {
    gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;  /* Header 104 */
};

&{/leds} {
    external_led2: led_2 {
        gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;  /* Header 106 */
    };
};

/ {
    aliases {
        led2 = &external_led2;
    };
};
