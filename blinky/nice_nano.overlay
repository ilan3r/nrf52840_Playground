#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&button0 {
    gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

&led0 {
    gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;  /* Header 100 */
};

&led1 {
    gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;  /* Header 104 */
};

&{/leds} {
    external_led2: led_2 {
        gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;  /* Header 106 */
    };
};

/ {
    aliases {
        led2 = &external_led2;
    };
};

/* The Feather's external flash shares D2 and D3 with our I2C wiring. */
&gd25q16 {
    status = "disabled";
};

&qspi {
    status = "disabled";
};

&i2c0_default {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
    };
};

&i2c0_sleep {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
        low-power-enable;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    bno055: bno055@28 {
        compatible = "bosch,bno055";
        reg = <0x28>;
        status = "okay";
    };
};
